# Required: Google AI Studio Gemini API key
GEMINI_API_KEY=

# Optional internet search: Tavily (1000 free searches/month) or Serper.
# If both are set, Tavily is used. Without either, regular Gemini answers still work.
TAVILY_API_KEY=
SERPER_API_KEY=

# Optional: Upstash Redis for "answer on the next phrase" mode when Gemini is slow.
# Added automatically by Vercel's Upstash integration (or use UPSTASH_REDIS_REST_URL/TOKEN).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: city for weather questions that do not name one (default: Новосибирск)
WEATHER_CITY=

# Optional; default is a fast and cost-efficient Gemini model
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: secret word for the settings report at /api?check=<HEALTH_TOKEN>; without it /api only says {"ok":true}
HEALTH_TOKEN=
